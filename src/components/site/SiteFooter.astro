---
import { site } from "../../config/site";

const currentYear = new Date().getFullYear();
const footerName = site.brand.name;
---

<footer class="astro-footer" aria-label="site-footer">
  <div class="astro-footer__lines astro-footer__lines--top" aria-hidden="true">
    <img src="/footer/footer-top.png" alt="" loading="lazy" />
  </div>

  <div class="astro-footer__content">
    <h2 class="astro-footer__wordmark" aria-label={footerName}>
      {footerName.split("").map((char, index) => (
        <span class="astro-footer__glyph-wrap" style={`--index: ${index};`}>
          <span class="astro-footer__glyph">{char}</span>
        </span>
      ))}
    </h2>

    <div class="astro-footer__bottom">
      <span>© {currentYear} {footerName}. Crafted with passion and code.</span>
    </div>
  </div>

  <div class="astro-footer__lines astro-footer__lines--bottom" aria-hidden="true">
    <img src="/footer/footer-bottom.png" alt="" loading="lazy" />
  </div>
</footer>

<style>
  .astro-footer {
    position: relative;
    display: flex;
    align-items: stretch;
    z-index: 1;
    width: 100%;
    max-width: 100vw;
    min-height: 61.8vh;
    min-height: 61.8svh;
    margin-top: 40px;
    background: #000;
    color: #f0f0f0;
    overflow: hidden;
    isolation: isolate;
  }

  .astro-footer__content {
    position: relative;
    z-index: 3;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 20px;
    width: min(1280px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 32px clamp(22px, 6vw, 84px) 52px;
  }

  .astro-footer__bottom {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    font-size: 15px;
    line-height: 24px;
    opacity: 0.75;
  }

  .astro-footer__wordmark {
    margin: 0;
    display: inline-flex;
    flex-wrap: nowrap;
    gap: 0;
    align-self: center;
    cursor: default;
    user-select: none;
    font-family: "Google Sans Flex", "Segoe UI", "PingFang SC", sans-serif;
    font-size: clamp(96px, 22vw, 280px);
    line-height: 0.82;
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  .astro-footer__glyph-wrap {
    display: inline-block;
    cursor: default;
    user-select: none;
    animation: astroDropBounce 1.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(0.25s + (var(--index) * 0.08s));
  }

  .astro-footer__glyph {
    display: inline-block;
    cursor: default;
    user-select: none;
    transform: translateY(0);
    transition: transform 0.25s ease-out;
    text-shadow:
      0 4px 14px rgba(255, 255, 255, 0.14),
      0 0 28px rgba(120, 200, 255, 0.22);
    animation: astroGlowPulse 3.6s ease-in-out infinite alternate;
  }

  .astro-footer__glyph-wrap:hover .astro-footer__glyph {
    transform: translateY(-14px);
    transition: transform 0.4s cubic-bezier(0.03, 0.72, 0.53, 1.25);
  }

  .astro-footer__lines {
    position: absolute;
    left: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100vw;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .astro-footer__lines--top {
    top: 0;
    aspect-ratio: 1307 / 71;
  }

  .astro-footer__lines--bottom {
    bottom: 0;
    aspect-ratio: 1307 / 220;
  }

  .astro-footer__lines img {
    width: clamp(1280px, 150vw, 3000px);
    max-width: 3000px;
    height: auto;
    object-fit: contain;
    opacity: 1;
    flex-shrink: 0;
  }

  @keyframes astroDropBounce {
    0%,
    25% {
      transform: translateY(-60px);
    }

    60% {
      transform: translateY(0);
    }

    75% {
      transform: translateY(-18px);
    }

    85% {
      transform: translateY(0);
    }

    92% {
      transform: translateY(-8px);
    }

    100% {
      transform: translateY(0);
    }
  }

  @keyframes astroGlowPulse {
    0% {
      text-shadow:
        0 4px 14px rgba(255, 255, 255, 0.14),
        0 0 28px rgba(120, 200, 255, 0.22);
    }

    100% {
      text-shadow:
        0 6px 22px rgba(255, 255, 255, 0.24),
        0 0 40px rgba(180, 225, 255, 0.32);
    }
  }

  @media (max-width: 768px) {
    .astro-footer__content {
      width: 100%;
      padding: 26px 0.75rem 76px;
      gap: 14px;
    }

    .astro-footer__wordmark {
      width: 100%;
      justify-content: center;
      font-family: "Google Sans Flex", "Segoe UI", "PingFang SC", sans-serif;
      font-size: clamp(82px, 24vw, 132px);
      letter-spacing: -0.03em;
    }

    .astro-footer__bottom {
      font-size: 13px;
      line-height: 1.65;
    }

    .astro-footer__lines {
      left: 0;
      width: 100%;
      transform: none;
    }

    .astro-footer__lines img {
      width: 100%;
      max-width: none;
    }

    .astro-footer__lines--bottom {
      aspect-ratio: 1307 / 220;
    }

    .astro-footer__lines--bottom img {
      width: max(1280px, 170vw);
      height: auto;
      object-fit: contain;
      object-position: center bottom;
    }
  }
</style>
