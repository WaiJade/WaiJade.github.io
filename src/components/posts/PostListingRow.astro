---
import { formatPostDate, getPostUrl, type PostEntry } from "../../lib/posts";

type Props = {
  post: PostEntry;
  currentTag?: string;
};

const { post, currentTag } = Astro.props;
const relatedTags = post.data.tags.filter((tag) => tag !== currentTag).slice(0, 3);
---

<a class="listing-post" href={getPostUrl(post)}>
  <time class="listing-post__date" datetime={post.data.pubDate.toISOString()}>
    {formatPostDate(post.data.pubDate)}
  </time>
  <div class="listing-post__main">
    <h2 class="listing-post__title">{post.data.title}</h2>
    {post.data.description && <p class="listing-post__excerpt">{post.data.description}</p>}
  </div>
  <div class="listing-post__meta">
    {relatedTags.length > 0 && (
      <div class="listing-post__tags" aria-label="文章标签">
        {relatedTags.map((tag) => (
          <span class="listing-post__tag">{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>
