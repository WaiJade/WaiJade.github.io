---
import { site } from "../config/site";

const pageTitle = `${site.title} / OFFLINE`;
const description = "当前网络不可用。你之前访问过的页面仍可能可以离线打开。";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#050816" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <style>
      :root {
        color-scheme: dark;
        --background: #050816;
        --background-soft: rgba(14, 18, 34, 0.92);
        --foreground: #f5f7ff;
        --muted: rgba(245, 247, 255, 0.7);
        --border: rgba(255, 255, 255, 0.1);
        --accent: #8fa7ff;
        --accent-strong: #d4deff;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: var(--background);
        color: var(--foreground);
        font-family:
          "MiSans", "MiSans Chinese", MiSans, "SF Pro Display", "Segoe UI", sans-serif;
      }

      body {
        min-height: 100vh;
        display: grid;
        place-items: center;
        overflow: hidden;
      }

      .offline-bg,
      .offline-grid,
      .offline-glow,
      .offline-vignette {
        position: fixed;
        inset: 0;
        pointer-events: none;
      }

      .offline-grid {
        background-image:
          linear-gradient(to right, rgba(255, 255, 255, 0.06) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
        background-size: 40px 40px;
        opacity: 0.42;
      }

      .offline-glow::before,
      .offline-glow::after {
        content: "";
        position: absolute;
        inset: 0;
      }

      .offline-glow::before {
        background:
          radial-gradient(62% 44% at 50% 100%, rgba(143, 167, 255, 0.28), transparent 72%),
          radial-gradient(40% 30% at 50% 8%, rgba(70, 95, 188, 0.16), transparent 70%);
      }

      .offline-glow::after {
        background: linear-gradient(
          to top,
          rgba(2, 4, 10, 0.94),
          rgba(2, 4, 10, 0.18) 55%,
          rgba(2, 4, 10, 0.9)
        );
      }

      .offline-vignette {
        background: radial-gradient(circle at 50% 45%, transparent 36%, rgba(0, 0, 0, 0.56) 100%);
      }

      .offline-shell {
        position: relative;
        z-index: 1;
        width: min(720px, calc(100vw - 2rem));
        padding: 1rem;
      }

      .offline-card {
        border: 1px solid var(--border);
        border-radius: 2rem;
        background: var(--background-soft);
        box-shadow: 0 24px 80px rgba(3, 7, 18, 0.32);
        backdrop-filter: blur(18px);
        padding: clamp(1.6rem, 4vw, 2.6rem);
      }

      .offline-eyebrow {
        margin: 0 0 0.85rem;
        color: var(--accent);
        font-family: "JetBrains Mono", "Fira Code", monospace;
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .offline-title {
        margin: 0;
        font-family: "NSourceSong", "Songti SC", "STSong", serif;
        font-size: clamp(2.1rem, 6vw, 3.5rem);
        line-height: 1.02;
        letter-spacing: -0.05em;
        font-weight: 400;
      }

      .offline-copy {
        margin: 1rem 0 0;
        max-width: 40rem;
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.8;
      }

      .offline-list {
        margin: 1.4rem 0 0;
        padding-left: 1.2rem;
        color: var(--muted);
        line-height: 1.9;
      }

      .offline-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-top: 1.8rem;
      }

      .offline-button {
        appearance: none;
        border: 1px solid rgba(143, 167, 255, 0.18);
        border-radius: 999px;
        min-height: 2.9rem;
        padding: 0 1.15rem;
        background: rgba(143, 167, 255, 0.16);
        color: var(--foreground);
        font: inherit;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition:
          transform 0.18s ease,
          background-color 0.22s ease,
          border-color 0.22s ease;
      }

      .offline-button:hover {
        transform: translateY(-1px);
        background: rgba(143, 167, 255, 0.22);
        border-color: rgba(143, 167, 255, 0.28);
      }

      .offline-button--ghost {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.12);
      }

      .offline-status {
        margin-top: 1.2rem;
        color: var(--accent-strong);
        font-size: 0.92rem;
      }

      @media (max-width: 720px) {
        .offline-card {
          border-radius: 1.6rem;
        }

        .offline-copy,
        .offline-list {
          font-size: 0.96rem;
        }

        .offline-actions {
          flex-direction: column;
        }

        .offline-button {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <div class="offline-bg" aria-hidden="true">
      <div class="offline-grid"></div>
      <div class="offline-glow"></div>
      <div class="offline-vignette"></div>
    </div>

    <main class="offline-shell">
      <section class="offline-card" aria-labelledby="offline-title">
        <p class="offline-eyebrow">Offline</p>
        <h1 id="offline-title" class="offline-title">当前网络不可用</h1>
        <p class="offline-copy">
          站点已经切换到离线页。如果你之前访问过某篇文章或首页，它们可能仍然可以从本地缓存中打开；未访问过的页面在断网状态下无法即时加载。
        </p>

        <ul class="offline-list">
          <li>先尝试点击“重新连接”。</li>
          <li>如果仍然离线，可以回到首页或归档，查看已缓存内容是否可访问。</li>
          <li>恢复联网后，刷新页面即可回到正常浏览状态。</li>
        </ul>

        <div class="offline-actions">
          <button class="offline-button" type="button" onclick="window.location.reload()">
            重新连接
          </button>
          <a class="offline-button offline-button--ghost" href="/">回到首页</a>
          <a class="offline-button offline-button--ghost" href="/archives/">查看归档</a>
        </div>

        <p class="offline-status" id="offline-status" aria-live="polite">
          当前状态：离线
        </p>
      </section>
    </main>

    <script is:inline>
      const statusElement = document.getElementById("offline-status");

      function updateStatus() {
        if (!statusElement) return;
        statusElement.textContent = navigator.onLine ? "当前状态：网络已恢复，可尝试重新连接" : "当前状态：离线";
      }

      updateStatus();
      window.addEventListener("online", updateStatus);
      window.addEventListener("offline", updateStatus);
    </script>
  </body>
</html>
