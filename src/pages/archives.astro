---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatPostDate, getPostUrl, getPublishedPosts, groupPostsByYear } from "../lib/posts";

const posts = await getPublishedPosts();
const postGroups = groupPostsByYear(posts);
---

<BaseLayout title="ARCHIVES">
  <section class="shell archives-page">
    <div class="archives-page__intro">
      <p class="page-panel__eyebrow">ARCHIVES</p>
      <h1 class="page-panel__title archives-page__title">开始接管旧文章归档</h1>
      <p class="page-panel__text">
        旧 `_posts/` 中的文章已经进入新的内容集合。这里先按年份整理为归档入口，后续再补专题、标签聚合和更完整的阅读路径。
      </p>
    </div>

    <div class="archives-page__groups">
      {postGroups.map(([year, yearPosts]) => (
        <section class="archive-year">
          <div class="archive-year__label">
            <span>{year}</span>
            <small>{yearPosts.length} 篇</small>
          </div>
          <div class="archive-year__list">
            {yearPosts.map((post) => (
              <a class="archive-item" href={getPostUrl(post)}>
                <div class="archive-item__main">
                  <h2 class="archive-item__title">{post.data.title}</h2>
                  {post.data.description && (
                    <p class="archive-item__excerpt">{post.data.description}</p>
                  )}
                </div>
                <div class="archive-item__meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatPostDate(post.data.pubDate)}
                  </time>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
