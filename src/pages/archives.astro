---
import ArchiveFilter from "../components/archives/ArchiveFilter";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/archives.css";
import {
  formatPostDate,
  getPostUrl,
  getPublishedPosts,
  getTagStats,
  groupPostsByYear,
} from "../lib/posts";

const posts = await getPublishedPosts();
const postGroups = groupPostsByYear(posts);
const archiveGroups = postGroups.map(([year, yearPosts]) => ({
  year,
  posts: yearPosts.map((post) => ({
    title: post.data.title,
    url: getPostUrl(post),
    date: formatPostDate(post.data.pubDate),
    dateTime: post.data.pubDate.toISOString(),
    tags: post.data.tags,
  })),
}));
const tagStats = getTagStats(posts);
---

<BaseLayout title="ARCHIVES" description="按年份与标签归档本站所有文章，便于检索与回顾。">
  <section class="shell archives-page">
    <div class="archives-page__intro">
      <p class="page-panel__eyebrow">ARCHIVES</p>
      <h1 class="page-panel__title archives-page__title">文章归档</h1>
      <p class="page-panel__text">
        此页按年份整理本站文章，并支持直接按标签筛选，便于检索、回顾与持续阅读。
      </p>
    </div>

    <ArchiveFilter client:load groups={archiveGroups} tags={tagStats} />
  </section>
</BaseLayout>
