---
import PostListingRow from "../components/posts/PostListingRow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts, groupPostsByYear } from "../lib/posts";

const posts = await getPublishedPosts();
const postGroups = groupPostsByYear(posts);
---

<BaseLayout title="ARCHIVES">
  <section class="shell listing-page">
    <div class="listing-header">
      <p class="page-panel__eyebrow">ARCHIVES</p>
      <h1 class="listing-header__title">按时间浏览全部文章</h1>
      <p class="listing-header__text">
        这里回到更接近旧博客的归档方式，直接按年份展开，减少大卡片，优先保证信息密度和浏览速度。
      </p>
    </div>

    <div class="archive-directory">
      {postGroups.map(([year, yearPosts]) => (
        <section class="archive-group">
          <div class="archive-group__heading">
            <span>{year}</span>
            <small>{yearPosts.length} POSTS</small>
          </div>
          <div class="archive-group__list">
            {yearPosts.map((post) => <PostListingRow post={post} />)}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
