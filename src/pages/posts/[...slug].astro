---
import type { PostEntry } from "../../lib/posts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FloatingToc from "../../components/posts/FloatingToc";
import PostComments from "../../components/posts/PostComments.astro";
import { site } from "../../config/site";
import {
  formatPostDate,
  getPostPathId,
  getPostExcerpt,
  getPostUrl,
  getPublishedPosts,
} from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: getPostPathId(post) },
    props: { post },
  }));
}

type Props = {
  post: PostEntry;
};

const { post } = Astro.props;
const posts = await getPublishedPosts();
const currentIndex = posts.findIndex((entry) => entry.id === post.id);
const newerPost = currentIndex > 0 ? posts[currentIndex - 1] : null;
const olderPost = currentIndex >= 0 ? posts[currentIndex + 1] : null;
const pageDescription = post.data.description || getPostExcerpt(post, 180, false);
const summary = post.data.description?.trim();
const { Content, headings } = await post.render();
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const hasToc = site.features.showToc && tocHeadings.length > 0;
const hasPagination = Boolean(newerPost || olderPost);
const paginationClassName = [
  "post-pagination",
  !newerPost && olderPost ? "post-pagination--single-right" : "",
  newerPost && !olderPost ? "post-pagination--single-left" : "",
]
  .filter(Boolean)
  .join(" ");
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: pageDescription,
  author: {
    "@type": "Person",
    name: site.author,
  },
  publisher: {
    "@type": "Organization",
    name: site.title,
  },
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: new URL(getPostUrl(post), site.url).toString(),
  keywords: post.data.tags,
};
---

<BaseLayout
  title={post.data.title}
  description={pageDescription}
  ogType="article"
  keywords={post.data.tags}
  publishedTime={post.data.pubDate.toISOString()}
  updatedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  articleTags={post.data.tags}
  ogImage={post.data.ogImage}
>
  <article class="shell article-page">
    <header class="article-header">
      <p class="article-header__eyebrow">Article / {formatPostDate(post.data.pubDate)}</p>
      <h1 class="article-header__title">{post.data.title}</h1>
      {summary && <p class="article-header__summary">{summary}</p>}
      {post.data.tags.length > 0 && (
        <div class="article-tags" aria-label="文章标签">
          {post.data.tags.map((tag) => (
            <a class="article-tag" href={`/archives/?tag=${encodeURIComponent(tag)}`}>
              {tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="article-body-wrap">
      <section class="article-body-panel">
        <section class="article-content">
          <Content />
        </section>
      </section>
    </div>

    {hasPagination && (
      <nav class={paginationClassName} aria-label="文章翻页">
        {newerPost && (
          <a class="post-pagination__item" href={getPostUrl(newerPost)}>
            <span class="post-pagination__label">NEWER</span>
            <strong>{newerPost.data.title}</strong>
          </a>
        )}

        {olderPost && (
          <a class="post-pagination__item post-pagination__item--align-end" href={getPostUrl(olderPost)}>
            <span class="post-pagination__label">OLDER</span>
            <strong>{olderPost.data.title}</strong>
          </a>
        )}
      </nav>
    )}

    {site.features.showComments && <PostComments />}

    {hasToc && <FloatingToc client:load headings={tocHeadings} />}
  </article>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</BaseLayout>
