---
import PostListingRow from "../../components/posts/PostListingRow.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, getTagStats } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getTagStats(posts);

  return tags.map((entry) => ({
    params: { tag: entry.tag },
    props: {
      tag: entry.tag,
      posts: posts.filter((post) => post.data.tags.includes(entry.tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`TAG ${tag}`}>
  <section class="shell listing-page">
    <div class="listing-header">
      <p class="page-panel__eyebrow">TAG</p>
      <h1 class="listing-header__title">{tag}</h1>
      <p class="listing-header__text">当前标签下共有 {posts.length} 篇文章，按日期倒序显示。</p>
    </div>

    <div class="archive-group__list">
      {posts.map((post) => <PostListingRow post={post} currentTag={tag} />)}
    </div>
  </section>
</BaseLayout>
