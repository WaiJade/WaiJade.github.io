---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import aboutSource from "../content/pages/about.mdx?raw";
import { friendsLinks } from "../content/friends";
import { site } from "../config/site";
import "../styles/about.css";

const aboutPage = (await getCollection("pages")).find((entry) => entry.id === "about.mdx");
const aboutBody = aboutSource.replace(/^---\s*\n[\s\S]*?\n---\s*\n?/, "");
const aboutParagraphs = Array.from(aboutBody.matchAll(/<p>([\s\S]*?)<\/p>/g), (match) => match[1].trim()).filter(Boolean);

if (!aboutPage) {
  throw new Error("缺少 src/content/pages/about.mdx");
}

if (!aboutParagraphs.length) {
  throw new Error("src/content/pages/about.mdx 缺少正文段落");
}
---

<BaseLayout title="ABOUT" description={aboutPage.data.description}>
  <section class="shell about-page">
    <section class="about-page__section animate-fadeIn">
      <div class="about-page__intro archives-page__intro">
        <p class="page-panel__eyebrow">ABOUT</p>
        <h1 class="page-panel__title archives-page__title">关于</h1>
      </div>

      <div class="about-page__body">
        <div class="about-page__avatar-wrap">
          <img
            class="about-page__avatar"
            src={site.brand.avatar}
            alt={site.author}
            loading="eager"
            decoding="async"
          />
        </div>

        <div class="about-section__copy">
          {aboutPage.data.lead && <p class="about-section__lead" set:html={aboutPage.data.lead} />}
          {aboutParagraphs.map((paragraph) => <p class="about-section__text" set:html={paragraph} />)}
        </div>
      </div>
    </section>

    {friendsLinks.length > 0 && (
      <section class="about-page__section about-page__friends-section animate-fadeIn">
        <div class="about-page__intro about-page__friends-intro archives-page__intro">
          <p class="page-panel__eyebrow">FRIENDS</p>
          <h2 class="page-panel__title archives-page__title">友情链接</h2>
        </div>

        <div class="about-page__friends">
          <div class="friends-grid" aria-label="friends-links">
            {friendsLinks.map((friend) => (
              <a
                class="friend-card"
                href={friend.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="friend-card__inner">
                  <div class="friend-card__avatar-wrap">
                    <img
                      class="friend-card__avatar"
                      src={friend.avatar}
                      alt={friend.name}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="friend-card__meta">
                    <h3 class="friend-card__name">{friend.name}</h3>
                    {friend.description && <p class="friend-card__desc">{friend.description}</p>}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </section>
</BaseLayout>
