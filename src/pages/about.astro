---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const aboutPage = (await getCollection("pages")).find((entry) => entry.id === "about.mdx");

if (!aboutPage) {
  throw new Error("缺少 src/content/pages/about.mdx");
}

const { Content } = await aboutPage.render();
---

<BaseLayout title={aboutPage.data.title} description={aboutPage.data.description}>
  <section class="shell archives-page about-page">
    <div class="archives-page__intro">
      <p class="page-panel__eyebrow">ABOUT</p>
      <h1 class="page-panel__title archives-page__title">{aboutPage.data.title}</h1>
      {aboutPage.data.lead && <p class="page-panel__text" set:html={aboutPage.data.lead} />}
    </div>

    <div class="article-body-panel page-panel__body">
      <section class="article-content">
        <Content />
      </section>
    </div>
  </section>
</BaseLayout>
