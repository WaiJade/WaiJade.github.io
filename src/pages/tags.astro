---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="标签">
  <section class="shell page-panel">
    <p class="page-panel__eyebrow">标签</p>
    <h1 class="page-panel__title">标签页将在内容迁移后接入</h1>
    <p class="page-panel__text">
      阶段一只固定博客路由和导航结构，后续会依据 content collections 自动生成标签列表与对应文章聚合页。
    </p>
  </section>
</BaseLayout>
