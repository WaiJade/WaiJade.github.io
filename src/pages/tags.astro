---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts, getTagStats } from "../lib/posts";

const posts = await getPublishedPosts();
const tags = getTagStats(posts);
---

<BaseLayout title="TAGS">
  <section class="shell tags-page">
    <div class="tags-page__intro">
      <p class="page-panel__eyebrow">TAGS</p>
      <h1 class="page-panel__title">以主题重新组织文章</h1>
      <p class="page-panel__text">
        这里先接入标签总览。下一步会继续补单个标签页、相关文章联动和更完整的内容浏览路径。
      </p>
    </div>

    <div class="tags-page__grid">
      {tags.map((item) => (
        <a class="tag-card" href={`/tags/${encodeURIComponent(item.tag)}/`}>
          <span class="tag-card__count">{item.count}</span>
          <h2 class="tag-card__title">{item.tag}</h2>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
