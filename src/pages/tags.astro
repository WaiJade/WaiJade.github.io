---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatPostDate, getPublishedPosts, getTagDirectory } from "../lib/posts";

const posts = await getPublishedPosts();
const tags = getTagDirectory(posts);
---

<BaseLayout title="TAGS">
  <section class="shell listing-page">
    <div class="listing-header">
      <p class="page-panel__eyebrow">TAGS</p>
      <h1 class="listing-header__title">按主题浏览文章目录</h1>
      <p class="listing-header__text">
        标签页也改成更紧凑的目录视图。每个标签显示文章数量，并附最近一篇文章，方便直接进入。
      </p>
    </div>

    <div class="tag-directory">
      {tags.map((item) => (
        <a class="tag-directory__item" href={`/tags/${encodeURIComponent(item.tag)}/`}>
          <div class="tag-directory__main">
            <h2 class="tag-directory__title">{item.tag}</h2>
            <p class="tag-directory__latest">{item.latestPost.data.title}</p>
          </div>
          <div class="tag-directory__meta">
            <span class="tag-directory__count">{item.count} POSTS</span>
            <span class="tag-directory__stats">
              {formatPostDate(item.latestPost.data.pubDate)}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
